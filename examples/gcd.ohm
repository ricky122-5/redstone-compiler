// Greatest common divisor by repeated subtraction.
// The `while` loop is what makes this a sequential circuit: the compiler
// builds a control FSM whose states are the basic blocks of this function.
input  u8 a;
input  u8 b;
output u8 g;

fn gcd(u8 x, u8 y) -> u8 {
    while (y != 0) {
        if (x > y) { x = x - y; } else { y = y - x; }
    }
    return x;
}

proc main() {
    g = gcd(a, b);
}
